# MedClarity has no server-side Gemini key. Users paste their own key in the app header.
# Get a key at https://aistudio.google.com/apikey

# Optional: HTTP port for `npm run dev` / `npm start` (default 3000).
# PORT=3000

# Optional: comma-separated Gemini models to try in order (default in lib/gemini-server.ts).
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
